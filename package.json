{
    "name": "faahh-arrow",
    "displayName": "FAAHH Arrow Function",
    "description": "Crie arrow functions mais rapidamente, com efeito sonoro.",
    "version": "1.0.0",
    "publisher": "BrunoBenicio",
    "icon": "icon.png",
    "private": true,
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Snippets",
        "Other"
    ],
    "activationEvents": [
        "onLanguage:javascript",
        "onLanguage:typescript",
        "onLanguage:javascriptreact",
        "onLanguage:typescriptreact"
    ],
    "main": "./extension.js",
    "contributes": {
        "commands": [
            {
                "command": "faahh-arrow.playSound",
                "title": "FAAHH: Play Sound"
            }
        ]
    },
    "scripts": {
        "lint": "eslint .",
        "pretest": "npm run lint",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/vscode": "^1.80.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "24.x",
        "eslint": "^10.5.0",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.0.0"
    },
    "overrides": {
        "diff": "^8.0.4",
        "serialize-javascript": "^7.0.6"
    }
}
